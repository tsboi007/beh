# Copy to .env.local for local development, or set these in Vercel → Project → Settings → Environment Variables.

# Required in production: Neon Postgres connection string (Vercel Marketplace → Neon, or neon.tech)
DATABASE_URL=

# Required: random string ≥ 32 chars (e.g. `openssl rand -hex 32`)
AUTH_SECRET=

# Admin login (created/updated on each deploy by scripts/setup-db.mjs)
ADMIN_EMAIL=admin@beh.vn
ADMIN_PASSWORD=

# Public URL of the site, used for SEO (sitemap, canonical, Open Graph)
NEXT_PUBLIC_SITE_URL=https://beh.vn

# Optional: Vercel Blob for image/CV uploads (auto-added when you connect a Blob store)
BLOB_READ_WRITE_TOKEN=

# Optional: email notifications for new bookings (e.g. Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Optional: Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
